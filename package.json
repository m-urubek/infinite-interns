{
  "name": "infinite-interns",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w infinite-interns-backend",
    "dev:frontend": "npm run dev -w infinite-interns-ui",
    "dev:both": "npm-run-all --parallel dev dev:frontend",
    "build": "npm run build -w infinite-interns-ui && npm run build -w infinite-interns-backend",
    "lint": "npm run lint -w infinite-interns-backend",
    "ts": "npm run ts -w infinite-interns-backend",
    "test": "npm run test -w infinite-interns-backend",
    "test:watch": "npm run test:watch -w infinite-interns-backend",
    "test:debug": "npm run test:debug -w infinite-interns-backend",
    "check-exports": "npm run check-exports -w infinite-interns-backend",
    "fix": "npm run fix -w infinite-interns-backend",
    "format": "npm run format -w infinite-interns-backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
